# Schwab Trader Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SCHWAB CREDENTIALS
# =============================================================================
# Get these from your Schwab Developer Portal
SCHWAB_API_KEY=your_schwab_api_key_here
SCHWAB_SECRET=your_schwab_secret_here
SCHWAB_REDIRECT_URL=https://127.0.0.1

# =============================================================================
# ALPACA CREDENTIALS (Optional - for Alpaca trading)
# =============================================================================
# Get these from your Alpaca Dashboard
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true

# =============================================================================
# PATHS
# =============================================================================
# Configuration directory (relative to project root)
CONFIG_PATH=config/

# Log directory (relative to project root)
LOG_DIR=logs/

# Data storage directory
DATA_PATH=data/data_storage/

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
# Environment mode: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# TRADING SETTINGS
# =============================================================================
# Default symbols to trade (comma-separated)
DEFAULT_SYMBOLS=AAPL,MSFT

# Trading mode: simulation, paper, live
TRADING_MODE=simulation

# =============================================================================
# RISK SETTINGS
# =============================================================================
# Base risk percentage per trade
BASE_RISK_PCT=0.01

# Maximum portfolio drawdown before halting
MAX_PORTFOLIO_DD=0.15

# Maximum symbol drawdown before halting
MAX_SYMBOL_DD=0.12

# Maximum pyramid layers
MAX_PYRAMID_LAYERS=2

# =============================================================================
# GUI SETTINGS
# =============================================================================
# GUI update interval in milliseconds
GUI_UPDATE_INTERVAL=100

# Chart buffer size (number of points)
CHART_BUFFER_SIZE=500

# =============================================================================
# DATABASE (Future use)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/schwab_trader

# =============================================================================
# NOTIFICATIONS (Future use)
# =============================================================================
# SLACK_WEBHOOK_URL=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_FROM=
# EMAIL_TO=
