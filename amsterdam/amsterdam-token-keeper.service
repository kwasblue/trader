[Unit]
Description=Amsterdam Schwab Token Keeper
After=network.target

[Service]
Type=simple
User=kwasi
WorkingDirectory=/home/kwasi/amsterdam
Environment="PATH=/home/kwasi/amsterdam/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/kwasi/amsterdam/venv/bin/python /home/kwasi/amsterdam/data/streaming/token_keeper.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
